<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La cámara es opcional: la app se puede instalar en equipos sin cámara -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Para hablar con los microservicios y con la API externa de feriados (aviso del formulario) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepSourceHoras">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeepSourceHoras"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DsHorasWidgetReceiver"
            android:exported="true"
            android:label="DS Horas · Proyectos y registro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ds_horas_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CronometroWidgetReceiver"
            android:exported="true"
            android:label="DS Horas · Cronómetro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ds_cronometro_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ResumenWidgetReceiver"
            android:exported="true"
            android:label="DS Horas · Resumen">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ds_resumen_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MiniWidgetReceiver"
            android:exported="true"
            android:label="DS Horas · Mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ds_mini_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ProyectosWidgetReceiver"
            android:exported="true"
            android:label="DS Horas · Proyectos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ds_proyectos_widget_info" />
        </receiver>

        <!-- Permite pasarle a la app de cámara un archivo de la app sin exponer su ruta -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>

</manifest>
