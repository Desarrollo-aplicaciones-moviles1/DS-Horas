<?xml version="1.0" encoding="utf-8"?>
<!-- Los microservicios corren en el PC con http (sin certificado).
     Solo se permite http hacia estas direcciones; todo lo demás (API de feriados) va por https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- localhost del PC visto desde el emulador -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Si usan un teléfono físico, agreguen aquí la IP del PC en la red, ej: 192.168.1.10 -->
    </domain-config>
</network-security-config>
