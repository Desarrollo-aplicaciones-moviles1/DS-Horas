<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa que se ve en el selector de widgets (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo_preview"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_deepsource" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DS HORAS"
            android:textColor="#8A87A0"
            android:textSize="10sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rediseño Web"
                android:textColor="#C9C6DA"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h"
                android:textColor="#9B8AD4"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App Móvil"
                android:textColor="#C9C6DA"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="38h"
                android:textColor="#9B8AD4"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dashboard"
                android:textColor="#C9C6DA"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12h"
                android:textColor="#9B8AD4"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_boton_preview"
            android:gravity="center"
            android:text="Registrar horas"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
</LinearLayout>
